# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public (sent to the browser); the secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated frontend hostnames accepted from Turnstile (never localhost in production)
TURNSTILE_HOSTNAMES=

# Resend — https://resend.com/api-keys
# CONTACT_FROM must use a domain verified in Resend, e.g. "Contact form <contact@ztssst.dev>".
RESEND_API_KEY=
CONTACT_FROM=
# Where submissions are delivered (defaults to main@ztssst.dev).
CONTACT_TO=main@ztssst.dev

# Optional: raises the GitHub API rate limit for the project stats.
GITHUB_TOKEN=

# Dev only: hostname of a tunnel used to preview the dev server (see next.config.ts).
DEV_TUNNEL_HOST=

# Optional: canonical site origin (e.g. https://ztssst.dev). Used as the counter key; defaults to the request host.
SITE_URL=
